generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum BookFormat {
  HARDCOVER
  PAPERBACK
  LEATHER
  EBOOK
  AUDIOBOOK
}

enum BookCondition {
  NEW
  LIKE_NEW
  VERY_GOOD
  GOOD
  FAIR
  POOR
}

enum ReadingStatus {
  WISHLIST
  UNREAD
  READING
  COMPLETED
  DNF
}

enum ContributorRole {
  AUTHOR
  TRANSLATOR
  ILLUSTRATOR
  EDITOR
}

enum UserRole {
  SUPER_ADMIN
  USER
}

enum UserStatus {
  PENDING
  APPROVED
  DISABLED
  REJECTED
}

enum CommunityMemberStatus {
  ACTIVE
  LEFT
  REMOVED
  BANNED
}

enum CommunityMessageType {
  TEXT
  POLL
  BOOK_SHARE
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  name         String
  passwordHash String
  role         UserRole   @default(USER)
  status       UserStatus @default(PENDING)
  createdAt    DateTime   @default(now())
  approvedAt   DateTime?
  approvedById String?

  sessions Session[]
  books    Book[]
  shelves  Shelf[]
  notes    Note[]

  communityMemberships CommunityMember[]
  communityMessages    CommunityMessage[]  @relation("CommunityMessageAuthor")
  deletedMessages      CommunityMessage[]  @relation("CommunityMessageDeletedBy")
  messageReactions     MessageReaction[]
  messageStars         MessageStar[]
  pollVotes            PollVote[]
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model Book {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  title                   String
  subtitle                String?
  seriesId                String?
  series                  Series?       @relation(fields: [seriesId], references: [id])
  volume                  Int?
  publisherId             String?
  publisher               Publisher?    @relation(fields: [publisherId], references: [id])
  publicationYear         Int?
  originalPublicationYear Int?
  isbn10                  String?
  isbn13                  String?
  language                String?
  country                 String?
  pages                   Int?
  weightGrams             Int?
  widthMm                 Int?
  heightMm                Int?
  depthMm                 Int?
  format                  BookFormat    @default(HARDCOVER)
  isSigned                Boolean       @default(false)
  isFirstEdition          Boolean       @default(false)
  isLimitedEdition        Boolean       @default(false)
  condition               BookCondition?

  coverImageUrl     String?
  backCoverImageUrl String?
  spineImageUrl     String?
  galleryImageUrls  String[]          @default([])

  purchaseDate        DateTime?
  purchaseSeller      String?
  purchaseInvoiceUrl  String?
  purchasePrice       Decimal?        @db.Decimal(10, 2)
  currentMarketValue  Decimal?        @db.Decimal(10, 2)
  insuranceValue      Decimal?        @db.Decimal(10, 2)

  shelfId       String?
  shelf         Shelf?  @relation(fields: [shelfId], references: [id])
  shelfPosition Int?
  qrCode        String?
  externalLink  String?

  summary          String? @db.Text
  aiSummary        String? @db.Text
  personalReview   String? @db.Text
  personalNotes    String? @db.Text

  readingStatus          ReadingStatus @default(UNREAD)
  currentPage            Int?
  readingProgressPercent Int           @default(0)
  rating                 Int?
  isFavorite             Boolean       @default(false)
  isRare                 Boolean       @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  contributors    BookContributor[]
  genres          BookGenre[]
  tags            BookTag[]
  quotes          Quote[]
  notes           Note[]
  readingSessions ReadingSession[]
  communityShares CommunityMessage[]

  @@unique([userId, isbn13])
  @@unique([userId, qrCode])
  @@index([readingStatus])
  @@index([shelfId])
  @@index([userId])
}

model Author {
  id        String            @id @default(cuid())
  name      String            @unique
  bio       String?           @db.Text
  birthYear Int?
  deathYear Int?
  photoUrl  String?
  createdAt DateTime          @default(now())

  books BookContributor[]
}

model BookContributor {
  bookId   String
  book     Book            @relation(fields: [bookId], references: [id], onDelete: Cascade)
  authorId String
  author   Author          @relation(fields: [authorId], references: [id], onDelete: Cascade)
  role     ContributorRole @default(AUTHOR)

  @@id([bookId, authorId, role])
}

model Publisher {
  id    String @id @default(cuid())
  name  String @unique
  books Book[]
}

model Series {
  id    String @id @default(cuid())
  name  String @unique
  books Book[]
}

model Genre {
  id    String      @id @default(cuid())
  name  String      @unique
  books BookGenre[]
}

model BookGenre {
  bookId  String
  book    Book   @relation(fields: [bookId], references: [id], onDelete: Cascade)
  genreId String
  genre   Genre  @relation(fields: [genreId], references: [id], onDelete: Cascade)

  @@id([bookId, genreId])
}

model Tag {
  id    String    @id @default(cuid())
  name  String    @unique
  books BookTag[]
}

model BookTag {
  bookId String
  book   Book   @relation(fields: [bookId], references: [id], onDelete: Cascade)
  tagId  String
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([bookId, tagId])
}

model Shelf {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label     String
  room      String?
  capacity  Int?
  createdAt DateTime @default(now())

  books Book[]

  @@index([userId])
}

model Quote {
  id         String   @id @default(cuid())
  bookId     String
  book       Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  text       String   @db.Text
  pageNumber Int?
  createdAt  DateTime @default(now())
}

model Note {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookId    String?
  book      Book?    @relation(fields: [bookId], references: [id], onDelete: SetNull)
  title     String?
  content   String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model ReadingSession {
  id         String    @id @default(cuid())
  bookId     String
  book       Book      @relation(fields: [bookId], references: [id], onDelete: Cascade)
  startedAt  DateTime  @default(now())
  endedAt    DateTime?
  minutesRead Int?
  pagesRead  Int?
}

// There is deliberately only ever one row in this table - BringBooks ships
// with a single community, not a discovery system for many. See
// lib/community.ts's getOrCreateCommunity for the auto-create-on-first-use.
model Community {
  id  String @id @default(cuid())
  // BringBooks ships one community, not many - this fixed key lets
  // getOrCreateCommunity() upsert atomically instead of racing a
  // findFirst-then-create across concurrent requests.
  singletonKey String  @unique @default("bringbooks-community")
  name         String
  description  String? @db.Text
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  members  CommunityMember[]
  messages CommunityMessage[]
}

model CommunityMember {
  id          String                @id @default(cuid())
  communityId String
  community   Community             @relation(fields: [communityId], references: [id], onDelete: Cascade)
  userId      String
  user        User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  status      CommunityMemberStatus @default(ACTIVE)
  isMuted     Boolean               @default(false)
  lastReadAt  DateTime              @default(now())
  lastSeenAt  DateTime              @default(now())
  typingUntil DateTime?
  joinedAt    DateTime              @default(now())

  @@unique([communityId, userId])
  @@index([communityId, status])
}

model CommunityMessage {
  id          String    @id @default(cuid())
  communityId String
  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  authorId    String
  author      User      @relation("CommunityMessageAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  type    CommunityMessageType @default(TEXT)
  content String?              @db.Text

  replyToId String?
  replyTo   CommunityMessage?  @relation("MessageReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies   CommunityMessage[] @relation("MessageReplies")

  forwardedFromId String?
  forwardedFrom   CommunityMessage?  @relation("MessageForwards", fields: [forwardedFromId], references: [id], onDelete: SetNull)
  forwards        CommunityMessage[] @relation("MessageForwards")

  sharedBookId String?
  sharedBook   Book?   @relation(fields: [sharedBookId], references: [id], onDelete: SetNull)

  poll Poll?

  isPinned   Boolean   @default(false)
  pinnedAt   DateTime?
  pinnedById String?

  isEdited Boolean   @default(false)
  editedAt DateTime?

  isDeleted   Boolean   @default(false)
  deletedAt   DateTime?
  deletedById String?
  deletedBy   User?     @relation("CommunityMessageDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  reactions MessageReaction[]
  stars     MessageStar[]

  @@index([communityId, createdAt])
  @@index([replyToId])
}

model MessageReaction {
  id        String           @id @default(cuid())
  messageId String
  message   CommunityMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  emoji     String
  createdAt DateTime         @default(now())

  @@unique([messageId, userId])
}

model MessageStar {
  id        String           @id @default(cuid())
  messageId String
  message   CommunityMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime         @default(now())

  @@unique([messageId, userId])
}

model Poll {
  id        String           @id @default(cuid())
  messageId String           @unique
  message   CommunityMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  question  String
  createdAt DateTime         @default(now())

  options PollOption[]
}

model PollOption {
  id     String @id @default(cuid())
  pollId String
  poll   Poll   @relation(fields: [pollId], references: [id], onDelete: Cascade)
  label  String

  votes PollVote[]
}

model PollVote {
  id        String     @id @default(cuid())
  pollId    String
  optionId  String
  option    PollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime   @default(now())

  @@unique([pollId, userId])
}
